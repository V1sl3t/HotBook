# Скопируйте в .env и заполните. .env не коммитится.
MODE=PROD
LOG_LEVEL=INFO

DB_HOST=db
DB_PORT=5432
DB_USER=hotbook
DB_PASS=change-me
DB_NAME=booking

REDIS_HOST=redis
REDIS_PORT=6379

# Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# false только для локальной разработки по http
COOKIE_SECURE=true

LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

MAX_UPLOAD_BYTES=5242880
# JSON-список, например ["https://hotbook.run.place"]
CORS_ORIGINS=[]

# Без SMTP_HOST письма не отправляются, а только пишутся в лог
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@hotbook.run.place

SENTRY_DSN=

# Число воркеров uvicorn
WEB_CONCURRENCY=2
